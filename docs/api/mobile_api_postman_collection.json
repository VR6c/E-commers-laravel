{
  "info": {
    "name": "E-Commerce Mobile Production API Collection",
    "description": "Complete collection of API endpoints for Mobile App integration (Authentication, Catalog, Wishlist, Checkout, Orders, ABA PayWay).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://e-commers-laravel.vercel.app",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"012345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile User Updated\",\n  \"phone\": \"0987654321\",\n  \"address\": \"Phnom Penh, Cambodia\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get Banners",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/banners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "banners"
              ]
            }
          }
        },
        {
          "name": "Get Brands",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "brands"
              ]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Get Social Media Links",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/social-media-links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "social-media-links"
              ]
            }
          }
        },
        {
          "name": "Get Products List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=phone&category=electronics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "phone"
                },
                {
                  "key": "category",
                  "value": "electronics"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product Suggestions (Autocomplete / Recommended)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/suggestions?q=phone&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "suggestions"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "phone"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Related Product Suggestions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/sample-product-slug/suggestions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "sample-product-slug",
                "suggestions"
              ]
            }
          }
        },
        {
          "name": "Get Product Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/sample-product-slug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "sample-product-slug"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Checkout & Payment",
      "item": [
        {
          "name": "Validate Coupon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "validate"
              ]
            }
          }
        },
        {
          "name": "Process Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2, \"price\": 29.99 }\n  ],\n  \"payment_method\": \"payway\",\n  \"shipping_address\": \"Street 2004, Phnom Penh\",\n  \"coupon_code\": \"WELCOME10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            }
          }
        },
        {
          "name": "Check PayWay Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/checkout/payway/status/TRAN_ID_HERE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "payway",
                "status",
                "TRAN_ID_HERE"
              ]
            }
          }
        },
        {
          "name": "PayWay Hosted Mobile WebView",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/checkout/payway/hosted-mobile/ORDER_ID_HERE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "payway",
                "hosted-mobile",
                "ORDER_ID_HERE"
              ]
            }
          }
        }
      ]
    }
  ]
}